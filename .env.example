# AWS region to deploy into
AWS_REGION=ap-south-1

# Groq API key (get one at console.groq.com) — used by explain_document
# and chat, both called directly over HTTPS with Python's built-in
# urllib. Passed to `sam deploy --parameter-overrides GroqApiKey=...`
# at deploy time, not read from this file directly.
GROQ_API_KEY=gsk_your_key_here

# Groq model id, same for both explaining documents and chat. Swapping
# it is a config change only. llama-3.3-70b-versatile and
# llama-3.1-8b-instant moved to Groq's Enterprise-only tier on
# 2026-08-16 and no longer work with a free/developer key —
# openai/gpt-oss-120b is Groq's own recommended replacement. See
# console.groq.com/docs/models for the current list before picking a
# different one.
GROQ_MODEL_ID=openai/gpt-oss-120b

# Set automatically by `sam deploy` outputs — copy into frontend/.env
DYNAMODB_TABLE_NAME=doculyze-results
S3_BUCKET_NAME=doculyze-uploads
